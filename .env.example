# ============================================================
# SkyPvP Utils - Environment Configuration
# ============================================================
# Copy this file to .env and fill in values before starting.
# ============================================================

# ---- Discord ----
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_APP_ID=your_discord_application_id_here
DISCORD_OWNER_ID=your_discord_user_id_here
# Optional: restrict command registration to one guild during dev
DISCORD_TEST_GUILD_ID=

# ---- Database ----
DATABASE_URL=postgresql://skypvp:skypvp@localhost:5432/skypvputils
DIRECT_URL=postgresql://skypvp:skypvp@localhost:5432/skypvputils

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- PikaNetwork API ----
PIKA_API_KEY=your_pika_network_api_key_here
PIKA_API_BASE_URL=https://stats.pika-network.net/api

# ---- Encryption (for Mineflayer credentials at rest) ----
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=generate_a_64_char_hex_key_here

# ---- Mineflayer (optional) ----
MINEFLAYER_ENABLED=false
MINEFLAYER_HOST=play.pika-network.net
MINEFLAYER_PORT=25565

# ---- Application ----
NODE_ENV=production
LOG_LEVEL=info
