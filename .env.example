# ============================================================
# SkyPvP Utils — Environment Configuration Template
# ============================================================
# Copy this file to .env and configure values before starting.
# ============================================================

# ---- Discord Configuration ----
# Bot token from Discord Developer Portal (https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Application Client ID
DISCORD_APP_ID=your_discord_application_id_here

# Primary Bot Owner Discord User ID (receives root OWNER permissions)
DISCORD_OWNER_ID=your_discord_user_id_here

# Optional: Additional Co-Owner Discord IDs (comma or space separated)
DISCORD_OWNER_IDS=

# Optional: Restrict slash command registration to a specific guild during development
DISCORD_TEST_GUILD_ID=

# ---- Database Configuration ----
# PostgreSQL database connection URL (or sqlite file:./dev.db for local dev)
DATABASE_URL=postgresql://skypvp:skypvp_secure_password@localhost:5432/skypvputils
DIRECT_URL=postgresql://skypvp:skypvp_secure_password@localhost:5432/skypvputils

# ---- Redis Configuration ----
# Redis connection URL for caching and BullMQ background task workers
REDIS_URL=redis://localhost:6379

# ---- PikaNetwork Stats API ----
# Official Stats API key (obtain in-game on PikaNetwork via /apikey)
PIKA_API_KEY=your_pika_network_api_key_here

# Official Stats API base endpoint
PIKA_API_BASE_URL=https://stats.pika-network.net/api

# ---- Cryptographic Encryption ----
# 64-character hexadecimal key used for AES-256-GCM encryption of stored credentials at rest
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=generate_a_64_char_hex_key_here

# ---- Mineflayer Observation Bot (Optional) ----
# Enable/disable auto-connection to PikaNetwork SkyPvP
MINEFLAYER_ENABLED=false
MINEFLAYER_HOST=play.pika-network.net
MINEFLAYER_PORT=25565

# ---- Application Environment ----
NODE_ENV=production
LOG_LEVEL=info
OUTPOST_DIAGNOSTIC=false
